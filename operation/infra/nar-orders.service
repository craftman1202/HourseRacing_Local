[Unit]
Description=NAR auto-order runner (Rakuten Keiba, live)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/machine_learner/HourseRacing_Local/operation
Environment=DISPLAY=:0 WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR=/run/user/1000 PYTHONUNBUFFERED=1
ExecStart=/home/machine_learner/HourseRacing_Local/operation/scripts/rakuten.sh -m narops.orders.runner --live --conf %h/.cache/nar-orders/orders_live.yaml
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
