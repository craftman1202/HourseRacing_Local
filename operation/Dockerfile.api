# nar-api 用イメージ（読み取り専用の Web API）。
#
# ビルドコンテキストはリポジトリのルート:
#   docker build -f operation/Dockerfile.api -t <image> .
#
# operation/Dockerfile（nar-ops、推論本体）と違い、lightgbm/onnxruntime/
# scikit-learn は入れない。nar-api は BigQuery を読むだけで推論しない
# （infra/services.json の nar-api SA は bigquery.dataViewer/jobUser のみ）。
# コールドスタートを 1〜2 秒に抑えるのが設計書 §5.1 の要件で、
# min-instances=0 の構成では起動のたびにその代償を払う。
#
# duckdb と scipy は narops.shared 経由（nar.features.builder / nar.eval.calibration /
# nar.models.ensemble）で間接的に import されるため軽量版でも必要。
# httpx は narops.api の `/races/{id}/betslip` が narops.discord.betslip を import する際、
# パッケージ __init__（discord/client.py, DiscordSender）が芋づる式に読み込むために必要
# （betslip 自体は httpx を使わないが、Python の import はパッケージ __init__ を避けられない）。
# lightgbm/onnxruntime/torch/scikit-learn/beautifulsoup4/lxml は使わない。
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN python -m pip install --upgrade pip \
 && python -m pip install \
      "pandas>=2.2" "numpy>=2.0" "scipy>=1.14" "duckdb>=1.1" "httpx>=0.27" \
      "pyyaml>=6.0" "fastapi>=0.115" "pydantic>=2.9" "uvicorn[standard]>=0.30" \
      "google-cloud-bigquery" "db-dtypes>=1.2" \
      "google-cloud-storage" "google-cloud-secret-manager"

COPY learning/src /app/learning/src
COPY operation/src /app/operation/src
COPY operation/conf /app/operation/conf

ENV PYTHONPATH=/app/operation/src:/app/learning/src

ENV PORT=8080
EXPOSE 8080

CMD exec uvicorn narops.api_app:create_app --factory --host 0.0.0.0 --port ${PORT}
