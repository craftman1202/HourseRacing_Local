# 実値は .env に置く（.gitignore 済み）。GCP では Secret Manager から注入する。
DISCORD_WEBHOOK_PREDICTION=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_ALERT=https://discord.com/api/webhooks/aaa/bbb
DISCORD_WEBHOOK_DAILY=https://discord.com/api/webhooks/ccc/ddd
DISCORD_WEBHOOK_DEADLETTER=https://discord.com/api/webhooks/eee/fff
DISCORD_MIN_EV=1.05
DISCORD_RATE_LIMIT_RPS=0.4
MAX_BET_PER_RACE=3000
MAX_BET_PER_DAY=10000

# 合成データで学習したモデルで live にしないための印（mode.validate）
# 実データで学習したら real にする
MODEL_PROVENANCE=synthetic
