# ローカル開発用。本番は Cloud Run の --set-env-vars / --set-secrets で注入する
# （operation 側の .env → envvar → Secret Manager という解決規約と揃えている）。

# nar-api の URL（ローカルでは --allow-unauthenticated で動かした nar-api を指す）
NAR_API_URL=http://localhost:8081

# Auth.js — 実際に動かすには Google Cloud Console で OAuth クライアント
# (種類: ウェブアプリケーション) を作成し、リダイレクト URI に
# <NAR_API_URLではなくnar-webのURL>/api/auth/callback/google を登録する
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# openssl rand -base64 32 で生成
AUTH_SECRET=
# 本番（Cloud Run）では必須。無いと next-auth が req.nextUrl.origin から
# 自前でオリジンを組み立てようとして `0.0.0.0:8080`（コンテナの bind
# アドレス）になり、サインイン後のリダイレクト先が壊れる（実測、
# 2026-08-30。trustHost: true や X-Forwarded-Host だけでは直らなかった —
# Cookie の書き込みには効くが、ミドルウェアの redirect Location 構築には
# 効かない）。nar-web の実際の公開 URL をそのまま入れる。
AUTH_URL=

# カンマ区切りの管理者メールアドレス。サインイン自体は Google アカウントが
# あれば誰でもできる（会員登録は自由）。ここに載っているメールだけが
# モデル昇格などの管理者操作を行える（app/models/page.tsx の isAdmin）。
NAR_ADMIN_EMAILS=

# 将来 Sentry を有効化する場合のみ（npx @sentry/wizard@latest -i nextjs を推奨）
# NEXT_PUBLIC_SENTRY_DSN=
