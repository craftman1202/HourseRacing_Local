# ローカル開発用。本番は Cloud Run の --set-env-vars / --set-secrets で注入する
# （operation 側の .env → envvar → Secret Manager という解決規約と揃えている）。

# nar-api の URL（ローカルでは --allow-unauthenticated で動かした nar-api を指す）
NAR_API_URL=http://localhost:8081

# Auth.js — 実際に動かすには Google Cloud Console で OAuth クライアント
# (種類: ウェブアプリケーション) を作成し、リダイレクト URI に
# <NAR_API_URLではなくnar-webのURL>/api/auth/callback/google を登録する
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# openssl rand -base64 32 で生成
AUTH_SECRET=

# カンマ区切りの許可メールアドレス（単一テナント運用）
NAR_ADMIN_EMAILS=

# 将来 Sentry を有効化する場合のみ（npx @sentry/wizard@latest -i nextjs を推奨）
# NEXT_PUBLIC_SENTRY_DSN=
